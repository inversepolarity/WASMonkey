{
  "manifest_version": 3,
  "name": "wasMonkey",
  "version": "0.1.0",
  "description": "Tampermonkey for WebAssembly: intercept, inspect, and patch WASM modules at load time.",
  "permissions": ["storage", "scripting", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/metadata.js", "src/patch-utils.js", "src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/metadata.js", "src/storage.js", "src/isolated-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "options_page": "src/ui/options.html",
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "wasMonkey"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/page-hook.js", "src/worker-hook.js", "vendor/binaryen/index.js", "vendor/wabt/index.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wasmonkey@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}