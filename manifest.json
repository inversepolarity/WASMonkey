{
  "manifest_version": 3,
  "name": "wasMonkey (prototype)",
  "version": "0.0.1",
  "description": "Prototype: intercept and log WASM loads (Phase 0 feasibility).",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": []
}